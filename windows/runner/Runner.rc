#include <windows.h>
#include "resource.h"

#define VERSION_AS_NUMBER 1,0,0,0
#define VERSION_AS_STRING "1.0.0"

VS_VERSION_INFO VERSIONINFO
  FILEVERSION VERSION_AS_NUMBER
  PRODUCTVERSION VERSION_AS_NUMBER
  FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
  FILEFLAGS VS_FF_DEBUG
#else
  FILEFLAGS 0x0L
#endif
  FILEOS VOS__WINDOWS32
  FILETYPE VFT_APP
  FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904e4"
    BEGIN
      VALUE "CompanyName", "Nyx Team" "\0"
      VALUE "FileDescription", "Nyx - Silent speed in pure darkness" "\0"
      VALUE "FileVersion", VERSION_AS_STRING "\0"
      VALUE "InternalName", "Nyx" "\0"
      VALUE "LegalCopyright", "Copyright (C) 2026. All rights reserved." "\0"
      VALUE "OriginalFilename", "nyx.exe" "\0"
      VALUE "ProductName", "Nyx" "\0"
      VALUE "ProductVersion", VERSION_AS_STRING "\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1252
  END
END
